# Hypa Bridge BFF — environment (copy to .env.local; never commit secrets)
# ----------------------------------------------------------------------------
# The API key lives ONLY on the server. It is read here and passed to
# @hypa/bridge-core, which adds it as the x-api-key header. It never reaches
# the browser.

# Hypa developer-API origin (defaults to the hosted API when unset).
HYPA_API_URL=https://api.hypaintelligence.com

# Required. Create a key at https://labs.hypaintelligence.com.
HYPA_API_KEY=

# BFF listen host/port (defaults: 0.0.0.0 / 5182).
HOST=0.0.0.0
PORT=5182

# Comma-separated browser origins allowed by CORS. The Vite dev app uses a
# same-origin /api proxy, so in development this can stay empty.
CORS_ORIGINS=
