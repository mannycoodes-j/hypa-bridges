# Bridge MCP server — environment
# Copy to .env.local (gitignored) or export these vars. Secrets stay server-side.

# Hypa developer API key — server-side only, never ship it to a client.
HYPA_API_KEY=

# Optional: override the Hypa API origin.
HYPA_API_URL=https://api.hypaintelligence.com

# Optional: listen port / host.
PORT=5183
HOST=127.0.0.1
